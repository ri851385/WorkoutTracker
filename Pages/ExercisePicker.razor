@page "/exercises"
@inject WorkoutSessionState State
@inject ExerciseCatalogService CatalogService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>種目を選択</PageTitle>

<a href="workout" class="back-link">← トレーニングに戻る</a>

<h1 class="page-title">種目を選択</h1>

@if (_isLoading)
{
    <p class="text-muted">読み込み中...</p>
}
else
{
    <div class="custom-exercise-form">
        <select class="form-select custom-exercise-category" @bind="_customExerciseCategory">
            @foreach (var category in _categoryNames)
            {
                <option value="@category">@category</option>
            }
        </select>
        <div class="custom-exercise-input-row">
            <input type="text" class="form-control" placeholder="種目名を入力"
                   @bind="_customExerciseName" @bind:event="oninput" />
            <button type="button" class="btn btn-primary" @onclick="AddCustomExercise"
                    disabled="@string.IsNullOrWhiteSpace(_customExerciseName)">
                追加
            </button>
        </div>
    </div>

    @foreach (var category in _categories)
    {
        <h2 class="category-title">@category.Name</h2>
        <div class="exercise-list">
            @foreach (var exerciseName in category.Exercises)
            {
                var name = exerciseName;
                var alreadyAdded = _addedExerciseNames.Contains(name);
                <div class="exercise-row">
                    <button type="button" class="exercise-item @(alreadyAdded ? "added" : "")"
                            disabled="@alreadyAdded" @onclick="() => AddExercise(name)">
                        <span>@name</span>
                        <span class="exercise-item-action">@(alreadyAdded ? "追加済み" : "+")</span>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm exercise-delete"
                            @onclick="() => DeleteExercise(name)" aria-label="種目を削除">
                        ✕
                    </button>
                </div>
            }
        </div>
    }
}

@code {
    private List<ExerciseCategory> _categories = [];
    private List<string> _categoryNames = [];
    private HashSet<string> _addedExerciseNames = [];
    private string _customExerciseName = "";
    private string _customExerciseCategory = "";
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await State.InitializeAsync();
        if (State.CurrentSession is null)
        {
            Navigation.NavigateTo("");
            return;
        }

        _addedExerciseNames = State.CurrentSession.Exercises.Select(e => e.ExerciseName).ToHashSet();
        _categoryNames = CatalogService.GetCategoryNames();
        _customExerciseCategory = _categoryNames.Count > 0 ? _categoryNames[0] : "";
        await ReloadCatalogAsync();
        _isLoading = false;
    }

    private async Task ReloadCatalogAsync()
    {
        _categories = await CatalogService.GetCategorizedExercisesAsync();
    }

    private async Task AddExercise(string name)
    {
        await State.AddExerciseAsync(name);
        Navigation.NavigateTo("workout");
    }

    private async Task AddCustomExercise()
    {
        var name = _customExerciseName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            return;
        }

        await CatalogService.AddCustomExerciseAsync(name, _customExerciseCategory);
        await State.AddExerciseAsync(name);
        Navigation.NavigateTo("workout");
    }

    private async Task DeleteExercise(string name)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"「{name}」を種目一覧から削除しますか？");
        if (!confirmed)
        {
            return;
        }

        await CatalogService.RemoveExerciseAsync(name);
        await ReloadCatalogAsync();
    }
}

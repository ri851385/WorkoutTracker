@page "/stats"
@inject WorkoutHistoryService HistoryService

<PageTitle>統計</PageTitle>

<a href="" class="back-link">← ホームに戻る</a>

<h1 class="page-title">統計</h1>

@if (_isLoading)
{
    <p class="text-muted">読み込み中...</p>
}
else if (_exerciseNames.Count == 0)
{
    <p class="text-muted">まだ記録がありません。</p>
}
else
{
    <div class="exercise-select">
        <label for="exercise-select">種目</label>
        <select id="exercise-select" class="form-select" @onchange="OnExerciseChanged">
            @foreach (var name in _exerciseNames)
            {
                <option value="@name" selected="@(name == _selectedExercise)">@name</option>
            }
        </select>
    </div>

    <h2 class="section-title">最大重量の推移</h2>

    @if (_points.Count == 0)
    {
        <p class="text-muted">この種目の記録がありません。</p>
    }
    else
    {
        <LineChart Points="_points" ValueSuffix="kg" />
    }
}

@code {
    private List<WorkoutSession> _history = [];
    private List<string> _exerciseNames = [];
    private string _selectedExercise = "";
    private List<ChartPoint> _points = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _history = await HistoryService.GetAllAsync();
        _exerciseNames = _history
            .SelectMany(s => s.Exercises)
            .Select(e => e.ExerciseName)
            .Distinct()
            .OrderBy(n => n, StringComparer.CurrentCulture)
            .ToList();

        if (_exerciseNames.Count > 0)
        {
            _selectedExercise = _exerciseNames[0];
            BuildPoints();
        }

        _isLoading = false;
    }

    private void OnExerciseChanged(ChangeEventArgs e)
    {
        _selectedExercise = e.Value?.ToString() ?? "";
        BuildPoints();
    }

    private void BuildPoints()
    {
        _points = _history
            .OrderBy(s => s.Date)
            .Select(s => new ChartPoint(
                s.Date,
                s.Exercises
                    .Where(ex => ex.ExerciseName == _selectedExercise)
                    .SelectMany(ex => ex.Sets)
                    .Select(set => (decimal?)set.Weight)
                    .Max() ?? -1))
            .Where(p => p.Value >= 0)
            .ToList();
    }
}

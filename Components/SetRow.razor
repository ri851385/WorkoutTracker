@using System.Globalization
@inject WorkoutSessionState State

<div class="set-row">
    <span class="set-number">@SetNumber</span>

    <div class="set-field">
        <input type="number" inputmode="decimal" step="0.25" min="0" max="999" @key="_weightKey"
               class="form-control" value="@Set.Weight" @onchange="OnWeightChanged" />
        <span class="set-unit">kg</span>
    </div>

    <div class="set-field">
        <input type="number" inputmode="numeric" step="1" min="1" max="999" @key="_repsKey"
               class="form-control" value="@Set.Reps" @onchange="OnRepsChanged" />
        <span class="set-unit">回</span>
    </div>

    <button type="button" class="btn btn-outline-danger btn-sm set-remove" @onclick="RemoveSet" aria-label="セットを削除">
        ✕
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public required SetEntry Set { get; set; }

    [Parameter]
    public int ExerciseIndex { get; set; }

    [Parameter]
    public int SetIndex { get; set; }

    [Parameter]
    public int SetNumber { get; set; }

    [Parameter]
    public EventCallback OnSetRemoved { get; set; }

    // Recreating the input via @key forces Blazor to write the (possibly clamped)
    // value back into the DOM even when the rendered attribute value is unchanged
    // from the last render — otherwise an out-of-range value stays visible on screen.
    private int _weightKey;
    private int _repsKey;

    private async Task OnWeightChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var value))
        {
            await State.UpdateSetAsync(ExerciseIndex, SetIndex, value, Set.Reps);
        }

        _weightKey++;
        StateHasChanged();
    }

    private async Task OnRepsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var value))
        {
            await State.UpdateSetAsync(ExerciseIndex, SetIndex, Set.Weight, value);
        }

        _repsKey++;
        StateHasChanged();
    }

    private async Task RemoveSet()
    {
        await State.RemoveSetAsync(ExerciseIndex, SetIndex);
        await OnSetRemoved.InvokeAsync();
    }
}
